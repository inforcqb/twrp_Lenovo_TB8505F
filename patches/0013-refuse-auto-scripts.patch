+// TB8505F: executed by the refuse-scripts gate via the confirm slider.
+// Runs the script path stored in tw_refuse_script_path (this session allow).
+int GUIAction::confirm_run_script(std::string arg __unused)
+{
+	std::string path;
+	DataManager::GetValue("tw_refuse_script_path", path);
+	if (!path.empty()) {
+		LOGINFO("confirm_run_script: executing '%s'\n", path.c_str());
+		chmod(path.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
+		TWFunc::Exec_Cmd(path);
+	} else {
+		LOGERR("confirm_run_script: no script path set\n");
+	}
+	return 0;
+}
