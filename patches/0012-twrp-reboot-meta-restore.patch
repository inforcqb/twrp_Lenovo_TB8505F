+// ===========================================================================
+// MetaGuard - TB8505F FDE metadata partition backup/restore
+// ---------------------------------------------------------------------------
+// vold's decrypt path (checkpw) can rewrite the *metadata* partition (the
+// crypto master-key blob lives in its first ~12KB). A metadata partition
+// left half-updated breaks OS decrypt on next boot. Snapshot it before any
+// decrypt attempt and restore it before ANY reboot/poweroff transition.
+//
+// Backup : /tmp/meta_backup.img (this session) + /data/local/tmp/meta_backup.img
+//          (persisted once /data is decrypted/mounted).
+// Restore: /tmp first, falls back to the persisted copy.
+// Guard  : a partition whose first 1MB is all zeros is blank/corrupt - never
+//          overwrite the persisted good copy with garbage.
+// ===========================================================================
+
+static const char* MetaGuard_Device() { return "/dev/block/platform/bootdevice/by-name/metadata"; }
+static const char* MetaGuard_TmpBackup() { return "/tmp/meta_backup.img"; }
+static const char* MetaGuard_DataBackup() { return "/data/local/tmp/meta_backup.img"; }
+
+static bool MetaGuard_IsDataMounted() {
+	std::ifstream mounts("/proc/mounts");
+	std::string line;
+	while (std::getline(mounts, line)) {
+		if (line.find(" /data ") != std::string::npos)
+			return true;
+	}
+	return false;
+}
+
+// First 1MB all zeros => blank/corrupt partition (failed flash, wipe, or
+// vold damage before we could snapshot it).
+static bool MetaGuard_IsBlank(const char* dev) {
+	unsigned char buf[4096];
+	int fd = open(dev, O_RDONLY);
+	if (fd < 0)
+		return false;
+	bool blank = true;
+	for (int i = 0; i < 256; i++) {
+		ssize_t n = read(fd, buf, sizeof(buf));
+		if (n <= 0)
+			break;
+		for (ssize_t j = 0; j < n; j++) {
+			if (buf[j] != 0) {
+				blank = false;
+				break;
+			}
+		}
+		if (!blank)
+			break;
+	}
+	close(fd);
+	return blank;
+}
+
+// Copy to a regular file via temp + rename (partial copy never clobbers dst).
+static bool MetaGuard_WriteFile(const char* src, const char* dst) {
+	int in = open(src, O_RDONLY);
+	if (in < 0)
+		return false;
+	std::string tmp(dst);
+	tmp += ".tmp";
+	int out = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	if (out < 0) {
+		close(in);
+		return false;
+	}
+	char buf[4096];
+	ssize_t n;
+	while ((n = read(in, buf, sizeof(buf))) > 0) {
+		ssize_t off = 0;
+		while (off < n) {
+			ssize_t w = write(out, buf + off, n - off);
+			if (w <= 0) {
+				close(in); close(out); unlink(tmp.c_str());
+				return false;
+			}
+			off += w;
+		}
+	}
+	close(in);
+	if (fsync(out) != 0) {
+		close(out); unlink(tmp.c_str());
+		return false;
+	}
+	close(out);
+	if (rename(tmp.c_str(), dst) != 0) {
+		unlink(tmp.c_str());
+		return false;
+	}
+	return true;
+}
+
+// Write directly to the metadata block device + fsync.
+static bool MetaGuard_WriteDevice(const char* src, const char* dev) {
+	int in = open(src, O_RDONLY);
+	if (in < 0)
+		return false;
+	int out = open(dev, O_WRONLY);
+	if (out < 0) {
+		close(in);
+		return false;
+	}
+	char buf[4096];
+	ssize_t n;
+	while ((n = read(in, buf, sizeof(buf))) > 0) {
+		ssize_t off = 0;
+		while (off < n) {
+			ssize_t w = write(out, buf + off, n - off);
+			if (w <= 0) {
+				close(in); close(out);
+				return false;
+			}
+			off += w;
+		}
+	}
+	close(in);
+	fsync(out);
+	close(out);
+	return true;
+}
+
+int TWFunc::MetaGuard_Backup() {
+	LOGINFO("MetaGuard: backup start\n");
+	if (!TWFunc::Path_Exists(MetaGuard_Device())) {
+		LOGINFO("MetaGuard: %s not present, skipping backup\n", MetaGuard_Device());
+		return 0;
+	}
+	if (MetaGuard_IsBlank(MetaGuard_Device())) {
+		LOGINFO("MetaGuard: %s first 1MB all zeros (blank/corrupt), keeping old backup\n", MetaGuard_Device());
+		return 0;
+	}
+	if (!MetaGuard_WriteFile(MetaGuard_Device(), MetaGuard_TmpBackup())) {
+		LOGERR("MetaGuard: backup FAILED writing %s\n", MetaGuard_TmpBackup());
+		return -1;
+	}
+	struct stat st;
+	if (stat(MetaGuard_TmpBackup(), &st) == 0)
+		LOGINFO("MetaGuard: backup %lld bytes -> %s\n", (long long)st.st_size, MetaGuard_TmpBackup());
+	if (MetaGuard_IsDataMounted()) {
+		if (MetaGuard_WriteFile(MetaGuard_TmpBackup(), MetaGuard_DataBackup()))
+			LOGINFO("MetaGuard: persisted copy -> %s\n", MetaGuard_DataBackup());
+	}
+	return 0;
+}
+
+int TWFunc::MetaGuard_Restore() {
+	LOGINFO("MetaGuard: restore start\n");
+	std::string src;
+	if (TWFunc::Path_Exists(MetaGuard_TmpBackup()))
+		src = MetaGuard_TmpBackup();
+	else if (MetaGuard_IsDataMounted() && TWFunc::Path_Exists(MetaGuard_DataBackup())) {
+		src = MetaGuard_DataBackup();
+		LOGINFO("MetaGuard: /tmp backup missing, using persisted %s\n", MetaGuard_DataBackup());
+	}
+	if (src.empty()) {
+		LOGINFO("MetaGuard: no backup found, nothing to restore\n");
+		return 0;
+	}
+	if (!MetaGuard_WriteDevice(src.c_str(), MetaGuard_Device())) {
+		LOGERR("MetaGuard: restore FAILED writing %s\n", MetaGuard_Device());
+		return -1;
+	}
+	sync();
+	LOGINFO("MetaGuard: restore done (%s -> %s)\n", src.c_str(), MetaGuard_Device());
+	// keep persisted copy in sync with the restored (pristine) image
+	if (MetaGuard_IsDataMounted())
+		MetaGuard_WriteFile(src.c_str(), MetaGuard_DataBackup());
+	return 0;
+}
